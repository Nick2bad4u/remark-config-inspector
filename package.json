{
    "name": "remark-config-inspector",
    "version": "2.2.7",
    "private": false,
    "description": "A visual tool for inspecting and understanding your remark and remark-lint configs",
    "keywords": [
        "@remark",
        "@remark/config-inspector",
        "config",
        "eslint-inspector",
        "inspector",
        "remark",
        "remark-config",
        "remark-config-inspector",
        "remark-lint",
        "remark-lint-plugin",
        "tool",
        "visualization"
    ],
    "homepage": "https://github.com/Nick2bad4u/remark-config-inspector#readme",
    "bugs": "https://github.com/Nick2bad4u/remark-config-inspector/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/remark-config-inspector.git"
    },
    "funding": "https://github.com/sponsors/Nick2bad4u",
    "license": "Apache-2.0",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)",
    "contributors": [
        {
            "name": "Nick2bad4u",
            "email": "20943337+Nick2bad4u@users.noreply.github.com",
            "url": "https://github.com/Nick2bad4u"
        }
    ],
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/cli.d.mts",
                "default": "./dist/cli.mjs"
            },
            "require": {
                "types": "./dist/cli.d.cts",
                "default": "./dist/cli.cjs"
            },
            "default": "./dist/cli.mjs"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/cli.cjs",
    "types": "./dist/cli.d.mts",
    "bin": {
        "remark-config-inspector": "bin.mjs"
    },
    "files": [
        "*.mjs",
        "dist"
    ],
    "scripts": {
        "build": "nuxt build && tsdown",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/remark-config-inspector --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/remark-config-inspector --unreleased",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/remark-config-inspector --current",
        "check": "npm run lint && npm run lint:stylelint && npm run typecheck && npm run test && npm run build",
        "contrib": "all-contributors",
        "contrib:add": "all-contributors add",
        "contrib:check": "all-contributors check",
        "contrib:compare": "npm run contrib:check",
        "contrib:generate": "all-contributors generate",
        "dev": "nuxt dev",
        "lint": "npm run lint:node-version-files && npm run lint:prettier && eslint --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:all": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache && npm run lint:stylelint && npm run typecheck && npm run lint:gitleaks && npm run lint:yamllint",
        "lint:all:fix": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache --fix && npm run lint:stylelint:fix && npm run typecheck && npm run lint:prettier:fix",
        "lint:fix": "npm run sync:node-version-files && npm run lint:prettier:fix && eslint --cache --cache-strategy content --cache-location .cache/.eslintcache --fix",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:jscpd": "jscpd --config node_modules/jscpd-config-nick2bad4u/jscpd.json",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml .",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md",
        "lint:node-version-files": "node scripts/sync-node-version-files.mjs --check",
        "lint:package": "npm run lint:node-version-files && npm run lint:package-sort-check && npm run lint:packagelintrc && npm run lint:tsdown",
        "lint:package:strict": "npm run lint:node-version-files && npm run lint:package-sort-check && npm run lint:package-check && npm run lint:packagelintrc && npm run lint:tsdown",
        "lint:package-check": "publint && attw --pack .",
        "lint:package-check:strict": "publint && attw --pack . --profile strict",
        "lint:package-json": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:package-sort": "sort-package-json \"./package.json\" \"./docs/docusaurus/package.json\"",
        "lint:package-sort-check": "sort-package-json --check \"./package.json\" \"./docs/docusaurus/package.json\"",
        "lint:packagelintrc": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:release": "npm run lint:all:fix && npm run lint:package-sort && npm run lint:package:strict",
        "lint:remark": "remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "remark . --ignore-path .remarkignore --output",
        "lint:stylelint": "stylelint \"**/*.{css,scss,sass,less,pcss,vue,html}\" --allow-empty-input --cache --cache-location .cache/.stylelintcache --ignore-pattern \"playwright-report/**\" --ignore-pattern \"test-results/**\" --ignore-pattern \".nuxt/**\" --ignore-pattern \"dist/**\" --ignore-pattern \"docs/docusaurus/build/**\"",
        "lint:stylelint:fix": "stylelint \"**/*.{css,scss,sass,less,pcss,vue,html}\" --allow-empty-input --cache --cache-location .cache/.stylelintcache --ignore-pattern \"playwright-report/**\" --ignore-pattern \"test-results/**\" --ignore-pattern \".nuxt/**\" --ignore-pattern \"dist/**\" --ignore-pattern \"docs/docusaurus/build/**\" --fix",
        "lint:tsdown": "tsdown --no-write",
        "lint:tsdown:build": "tsdown",
        "lint:yamllint": "yamllint -c .yamllint .",
        "prepack": "npm run build",
        "playwright:install": "playwright install --with-deps",
        "prebench": "npm run build",
        "prepare": "nuxt prepare",
        "release:check": "npm run check && npm run lint:package:strict && npm pack --dry-run",
        "prestart": "npm run build",
        "start": "node bin.mjs",
        "sync:node-version-files": "node scripts/sync-node-version-files.mjs",
        "test": "vitest --run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "npm run build && cross-env NODE_OPTIONS=--disable-warning=DEP0205 playwright test",
        "test:e2e:headed": "npm run build && cross-env NODE_OPTIONS=--disable-warning=DEP0205 playwright test --headed",
        "test:e2e:ui": "npm run build && cross-env NODE_OPTIONS=--disable-warning=DEP0205 playwright test --ui",
        "typecheck": "nuxt typecheck",
        "update-actions": "actions-up --yes --style sha",
        "update-deps": "ncu --configFileName .ncurc.json --configFilePath node_modules/ncu-config-nick2bad4u && npm install"
    },
